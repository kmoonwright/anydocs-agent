# --- auth for this agent's own HTTP API ---
ANYDOCS_API_TOKEN=dev-token
# Signing key for approval resume tokens. Generate: python -c "import secrets;print(secrets.token_hex(32))"
ANYDOCS_SIGNING_KEY=change-me-in-deployment

# --- model providers (only the ones your config/models.yaml roles use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- web search (Scout) ---
TAVILY_API_KEY=
# tavily | fixture
SEARCH_PROVIDER=tavily

# --- tracing: phoenix (local) | ax (deployed) | none ---
TRACE_TARGET=phoenix
PHOENIX_ENDPOINT=http://localhost:6006
ANYDOCS_PROJECT_NAME=anydocs-agent

# Only read when TRACE_TARGET=ax. Source these from `ax profiles` / ~/.arize/profiles/.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# Must end in /v1/traces: the collector answers 200 at /v1 and discards the spans.
ARIZE_ENDPOINT=https://otlp.arize.com/v1/traces

# Flush spans after each response instead of on a batch timer. Set this on any host that freezes
# the process once the response is sent, or the spans are lost without an error.
ANYDOCS_FLUSH_SPANS=false
# Add LangChain's own spans. Off by default: its callbacks do not join the OpenTelemetry context,
# so they arrive as a second copy of the turn rather than as extra depth.
ANYDOCS_FRAMEWORK_SPANS=off

# --- storage ---
ANYDOCS_DATA_DIR=./data

# --- CLI ---
# Where `anydocs ask --remote` sends the turn.
ANYDOCS_REMOTE_URL=http://127.0.0.1:8000

# --- side-effect ceiling ---
# Caps `crawl`, `write` and `delete` (off | ask | auto) below config/policy.default.yaml. A request's
# `overrides.policy` can tighten these but never raise them. Unset means the YAML decides.
# ANYDOCS_CRAWL_MODE=off
# ANYDOCS_WRITE_MODE=off
# ANYDOCS_DELETE_MODE=off

# --- Vercel (read-only playground endpoint) ---
# Set these in the Vercel project, not in a file that is uploaded. See docs/deploy.md.
# ANYDOCS_API_TOKEN=<random; startup refuses the defaults in serverless mode>
# ANYDOCS_SIGNING_KEY=<random; startup refuses the defaults in serverless mode>
# ANYDOCS_DATA_DIR=/tmp/anydocs
# ANYDOCS_FLUSH_SPANS=true
# ANYDOCS_CRAWL_MODE=off
# ANYDOCS_WRITE_MODE=off
# ANYDOCS_DELETE_MODE=off
# TRACE_TARGET=ax
# ANYDOCS_PROJECT_NAME=anydocs-agent
# ARIZE_SPACE_ID=
# ARIZE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CRON_SECRET=<random; enables GET /cron/turn, the synthetic demo traffic>
